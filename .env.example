# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=DanmarkFinanceBot
# The Telegram group chat ID where proposals will be posted (e.g., -100123456789)
GROUP_CHAT_ID=-1000000000000

# Optional: default timezone used for dates when a user's country is unknown.
TIMEZONE=Europe/Copenhagen

# Admin Configuration
ADMIN_USERNAME=YourAdminUsername # Without @ symbol

# Legacy single-admin id. Still read, and used as the default for the two below.
ADMIN_CHAT_ID=123456789

# Where admin notifications are sent. THIS one may be a group chat id.
# Defaults to ADMIN_CHAT_ID when unset.
ADMIN_NOTIFY_CHAT_ID=-1000000000000

# The admin who is always recognised, so a fresh deploy has someone who can add the
# rest. This MUST be an individual Telegram id: a group id can never match the sender,
# which is why pointing the old ADMIN_CHAT_ID at a group disabled every admin button.
# Defaults to ADMIN_CHAT_ID when unset. Further admins live in the Admin table.
BOOTSTRAP_ADMIN_ID=123456789

# Database Configuration (PostgreSQL)
# For local Docker Compose, use: postgresql://postgres:postgres@localhost:5432/danmark_db?schema=public
# For inside docker network, use: postgresql://postgres:postgres@db:5432/danmark_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/danmark_db?schema=public

# Postgres credentials for local Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=danmark_db
