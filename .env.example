# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=DanmarkFinanceBot
# The Telegram group chat ID where proposals will be posted (e.g., -100123456789)
GROUP_CHAT_ID=-1000000000000

# Admin Configuration
ADMIN_USERNAME=YourAdminUsername # Without @ symbol
ADMIN_CHAT_ID=123456789 # Numeric Telegram ID of the Admin user or admin group

# Database Configuration (PostgreSQL)
# For local Docker Compose, use: postgresql://postgres:postgres@localhost:5432/danmark_db?schema=public
# For inside docker network, use: postgresql://postgres:postgres@db:5432/danmark_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/danmark_db?schema=public

# Postgres credentials for local Docker Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=danmark_db
